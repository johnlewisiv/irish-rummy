# SERVER ONLY. Never prefix these secrets with VITE_ or copy into client files.
# Supabase Connect > Session pooler (IPv4, port 5432). URL-encode the password.
IRISH_RUMMY_DATABASE_URL=postgresql://SERVER_USER:URL_ENCODED_PASSWORD@SESSION_POOLER_HOST:5432/postgres
IRISH_RUMMY_STATE_KEY=family-games
# Public certificate downloaded from the Supabase dashboard; keep verification enabled.
IRISH_RUMMY_DATABASE_CA_FILE=server/certs/supabase-prod-ca-2021.crt

# Local development defaults to server/.data/rooms.json when no database URL is set.
# Existing Render disk can remain attached as a preserved fallback / import source.
# ROOM_STATE_FILE=/var/data/irish-rummy-state.json
PORT=3050
# BASE_PATH=/rummy
